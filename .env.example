# Copy to backend/.env for local development. Never commit real values.
# AWS credentials come from the standard AWS chain (aws configure / AWS_PROFILE / SSO). Do NOT put keys in code.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_REGION=us-east-1
# Optional: text-only model for JSON repair / refinement / code-fix (defaults to BEDROCK_MODEL_ID)
# BEDROCK_TEXT_MODEL_ID=
# BEDROCK_TIMEOUT_S=40
# Offline demo (no Bedrock call for the image step):
# ANALYSIS_FIXTURE=tests/fixtures/sample_analysis.json
# PORT=8000
